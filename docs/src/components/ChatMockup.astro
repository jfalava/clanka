---
/**
 * A drawn chat, not a screenshot: one exchange as Telegram, an iOS chat app or
 * the `clanka chat` terminal shows it. Marks render the way each client does
 * for the companion's messages; what you type stays as typed, except that
 * Telegram turns `code` into monospace when you send it.
 */
interface Message {
  from: "you" | "them";
  text: string;
}

interface Props {
  look: "telegram" | "ios" | "terminal";
  name: string;
  caption?: string;
  messages: Message[];
}

const { look, name, caption, messages } = Astro.props;

type Part = { kind: "text" | "mark" | "code"; text: string };

// Odd pieces of a split on a capturing group are the matches.
const parse = (text: string): Part[] =>
  text.split(/(\*[^*\n]+\*|`[^`\n]+`)/).map((s, i) => ({
    kind: i % 2 === 0 ? "text" : s.startsWith("*") ? "mark" : "code",
    text: s,
  }));

const rendered = (from: Message["from"], kind: Part["kind"]) =>
  look !== "terminal" && (from === "them" || (kind === "code" && look === "telegram"));
---

<figure class={`chat-mockup chat-${look}`}>
  {
    look === "terminal" ? (
      <div class="screen">
        {messages.map((m) => (
          <p class="line">
            <span class={m.from === "you" ? "prompt-you" : "prompt-them"}>
              {m.from === "you" ? "you>" : `${name.toLowerCase()}>`}
            </span>{" "}
            {m.text}
          </p>
        ))}
      </div>
    ) : (
      <div class="screen">
        <div class="header">
          <span class="avatar" aria-hidden="true">
            {name[0]}
          </span>
          <span class="who">
            <span class="name">{name}</span>
            <span class="status">{look === "telegram" ? "bot" : "online"}</span>
          </span>
        </div>
        <div class="thread">
          {messages.map((m) => (
            <p class={`bubble ${m.from}`}>
              {parse(m.text).map((p) =>
                !rendered(m.from, p.kind) || p.kind === "text" ? (
                  p.text
                ) : p.kind === "code" ? (
                  <code>{p.text.slice(1, -1)}</code>
                ) : look === "telegram" ? (
                  <strong>{p.text.slice(1, -1)}</strong>
                ) : (
                  <em>{p.text.slice(1, -1)}</em>
                ),
              )}
            </p>
          ))}
        </div>
      </div>
    )
  }
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .chat-mockup {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  figcaption {
    font-size: 0.8125rem;
    color: var(--nb-muted-foreground);
    text-align: center;
  }
  .screen {
    overflow: hidden;
    font-size: 0.875rem;
    line-height: 1.4;
  }
  p {
    margin: 0;
  }

  /* Phones */
  .chat-telegram .screen,
  .chat-ios .screen {
    border-radius: 1.75rem;
    border: 6px solid #1c1c1e;
    flex: 1;
  }
  .header {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    padding: 0.625rem 0.875rem;
  }
  .avatar {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border-radius: 9999px;
    font-weight: 600;
    color: #fff;
  }
  .who {
    display: flex;
    flex-direction: column;
    line-height: 1.2;
  }
  .name {
    font-weight: 600;
  }
  .status {
    font-size: 0.75rem;
    opacity: 0.6;
  }
  .thread {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    padding: 0.75rem;
  }
  .bubble {
    max-width: 85%;
    padding: 0.4375rem 0.75rem;
    white-space: pre-line;
    overflow-wrap: break-word;
  }
  .bubble.you {
    align-self: flex-end;
  }
  .bubble.them {
    align-self: flex-start;
  }
  .bubble code {
    font-size: 0.8125rem;
    padding: 0 0.25rem;
    border-radius: 0.25rem;
  }

  /* Telegram, dark theme */
  .chat-telegram .screen {
    background: #0e1621;
    color: #f5f5f5;
  }
  .chat-telegram .header {
    background: #17212b;
  }
  .chat-telegram .avatar {
    background: #7c5cc4;
  }
  .chat-telegram .bubble {
    border-radius: 0.875rem;
  }
  .chat-telegram .bubble.you {
    background: #2b5278;
    border-bottom-right-radius: 0.25rem;
  }
  .chat-telegram .bubble.them {
    background: #182533;
    border-bottom-left-radius: 0.25rem;
  }
  .chat-telegram code {
    background: rgb(255 255 255 / 0.1);
    color: #8fd3ff;
  }

  /* iOS, light */
  .chat-ios .screen {
    background: #fff;
    color: #000;
  }
  .chat-ios .header {
    flex-direction: column;
    gap: 0.25rem;
    background: #f6f6f6;
    border-bottom: 1px solid #e5e5ea;
  }
  .chat-ios .who {
    align-items: center;
  }
  .chat-ios .avatar {
    background: linear-gradient(#a5a9b4, #868a96);
  }
  .chat-ios .bubble {
    border-radius: 1.125rem;
  }
  .chat-ios .bubble.you {
    background: #007aff;
    color: #fff;
  }
  .chat-ios .bubble.them {
    background: #e9e9eb;
  }
  .chat-ios code {
    background: rgb(0 0 0 / 0.08);
  }

  /* clanka chat */
  .chat-terminal .screen {
    border-radius: 0.5rem;
    border: 1px solid var(--nb-border);
    background: #111;
    color: #e5e5e5;
    padding: 0.875rem 1rem;
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: 0.8125rem;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }
  .prompt-you {
    font-weight: 700;
  }
  .prompt-them {
    font-weight: 700;
    color: #22d3ee;
  }

  /* Phones side by side in a .chat-mockups wrapper. */
  :global(.docs-content .chat-mockups) {
    display: grid;
    gap: 1.25rem;
    grid-template-columns: repeat(auto-fill, minmax(16rem, 1fr));
    align-items: stretch;
  }
</style>
